# Copy this file to .env.local for local testing with `vercel dev`, and add
# the same variables in your Vercel Project Settings → Environment Variables
# for production. Never commit the real .env / .env.local file.

# --- Email notifications (Resend) ---
RESEND_API_KEY=
# For quick testing you can use Resend's shared sender: onboarding@resend.dev
# For production, verify your own domain in Resend and use an address on it.
EMAIL_FROM=
# The inbox where you want to receive new inquiries.
EMAIL_TO=

# --- WhatsApp notifications (Meta WhatsApp Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Your WhatsApp number in international format, digits only, no "+" or spaces
# (e.g. 919876543210 for a +91 98765 43210 number).
WHATSAPP_RECIPIENT_NUMBER=919084386006
# Optional — defaults to v21.0 if unset.
WHATSAPP_API_VERSION=

# Optional. Once you've created and Meta has approved a message template
# (see README), set its name/language here to use it instead of free-form
# text. Required for reliable production delivery — see README for why.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=

# --- WhatsApp "Let's Talk" CTA / floating button (frontend, public) ---
# Prefix with VITE_ so Vite exposes it to the browser — this number is meant
# to be public (it's what visitors click to message you), unlike
# WHATSAPP_RECIPIENT_NUMBER above which is only used server-side.
# Same format: digits only, no "+" or spaces (e.g. 919876543210).
# Until this is set, all WhatsApp CTAs (floating button, CTA section, footer)
# stay hidden rather than showing a broken link.
VITE_WHATSAPP_NUMBER=919084386006
